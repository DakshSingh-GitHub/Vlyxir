{
  "name": "judge-frontend",
  "version": "7.3.20",
  "description": "Vlyxir - NextGen Coding Platform Desktop",
  "author": "Vlyxir Team",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tag": "node tag_problems.js",
    "generate-problems": "node generate_problems.js",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "build:exe": "next build && electron-builder --win",
    "build:dmg": "next build && electron-builder --mac",
    "electron:dist": "next build && electron-builder --win --mac"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.6",
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/animejs": "^3.1.13",
    "animejs": "^4.3.6",
    "date-fns": "^4.1.0",
    "driver.js": "^1.3.1",
    "framer-motion": "^12.27.5",
    "groq-sdk": "^1.1.2",
    "leo-profanity": "^1.9.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "serve-handler": "^6.1.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.vlyxir.app",
    "productName": "Vlyxir",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".next/**/*",
      "public/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icons/icon-512x512.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icons/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
