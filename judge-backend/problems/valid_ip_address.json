{
    "id": "valid_ip_address",
    "title": "Valid IP Address",
    "description": "Given a string queryIP, return 'IPv4' if it is a valid IPv4 address, 'IPv6' if it is a valid IPv6 address, or 'Neither' if it is not valid.",
    "input_format": "A single string queryIP.",
    "output_format": "'IPv4', 'IPv6', or 'Neither'.",
    "constraints": {
        "queryIP": "1 <= queryIP.length <= 50"
    },
    "difficulty": "medium",
    "judge_mode": "str_compare_strip",
    "time_limit": 1,
    "sample_test_cases": [
        {
            "input": "172.16.254.1",
            "output": "IPv4"
        },
        {
            "input": "256.256.256.256",
            "output": "Neither"
        },
        {
            "input": "2001:0db8:85a3::8A2E:0370:7334",
            "output": "Neither"
        }
    ],
    "hidden_test_cases": [
        {
            "input": "192.168.1.01",
            "output": "Neither"
        },
        {
            "input": "2001:0db8:85a3:0000:0000:8a2e:0370:7334",
            "output": "IPv6"
        },
        {
            "input": "2001:db8:85a3:0:0:8A2E:0370:7334",
            "output": "IPv6"
        }
    ],
    "tags": [
        "Math",
        "String"
    ]
}